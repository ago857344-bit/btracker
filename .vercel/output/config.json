{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/api/gemini/?(?:/__data.json)?$",
			"dest": "/api/gemini"
		},
		{
			"src": "^/api/proxy-image/?(?:/__data.json)?$",
			"dest": "/api/proxy-image"
		},
		{
			"src": "^/auth/callback/?(?:/__data.json)?$",
			"dest": "/auth/callback"
		},
		{
			"src": "^/dump/?(?:/__data.json)?$",
			"dest": "/dump"
		},
		{
			"src": "^/focus/?(?:/__data.json)?$",
			"dest": "/focus"
		},
		{
			"src": "^/login/?(?:/__data.json)?$",
			"dest": "/login"
		},
		{
			"src": "^/log/?(?:/__data.json)?$",
			"dest": "/log"
		},
		{
			"src": "^/plan/?(?:/__data.json)?$",
			"dest": "/plan"
		},
		{
			"src": "^/reminders/?(?:/__data.json)?$",
			"dest": "/reminders"
		},
		{
			"src": "^/review/?(?:/__data.json)?$",
			"dest": "/review"
		},
		{
			"src": "^/revise/?(?:/__data.json)?$",
			"dest": "/revise"
		},
		{
			"src": "^/settings/?(?:/__data.json)?$",
			"dest": "/settings"
		},
		{
			"src": "^/stats/?(?:/__data.json)?$",
			"dest": "/stats"
		},
		{
			"src": "^/tests/?(?:/__data.json)?$",
			"dest": "/tests"
		},
		{
			"src": "^/todo/?(?:/__data.json)?$",
			"dest": "/todo"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}