# Supabase Configuration for Google Sign-in & Cloud Sync
# Get these from your Supabase project: Project Settings → API
PUBLIC_SUPABASE_URL=your-supabase-project-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Configuration (for direct Google OAuth)
# Get these from Google Cloud Console: APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Leave these blank to run in local-only mode (no cloud sync)
