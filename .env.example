# Google OAuth — powers sign-in.
# Get these from Google Cloud Console: APIs & Services → Credentials.
# Redirect URI to register: http://localhost:1420/auth/callback
# The client ID is public (browser); the secret is used server-side only and must NOT get a VITE_ prefix.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Supabase — enables cloud sync on top of Google sign-in.
# Get these from your Supabase project: Project Settings → API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Leave the Google keys blank to run in local-only mode (no sign-in, no cloud sync).
